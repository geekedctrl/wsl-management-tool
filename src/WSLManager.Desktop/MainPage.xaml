<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WSLManager_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WSLManager_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <local:DistributionLogoConverter x:Key="DistributionLogoConverter" />
        <DataTemplate x:Key="OnlineDistributionTemplate">
            <Grid Padding="4,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Image Width="34" Height="34" Source="{Binding LogoKey, Converter={StaticResource DistributionLogoConverter}}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding FriendlyName}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RegistrationStatus}" FontSize="11" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <NavigationView x:Name="AppNavigation" IsSettingsVisible="False" PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed" ItemInvoked="Navigation_ItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Distributions" Tag="Distributions"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Backup &amp; Restore" Tag="Backup"><NavigationViewItem.Icon><SymbolIcon Symbol="Save" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Move &amp; Clone" Tag="Migration"><NavigationViewItem.Icon><SymbolIcon Symbol="MoveToFolder" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Storage" Tag="Storage"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Diagnostics" Tag="Diagnostics"><NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid x:Name="Workspace" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="Workspace_SizeChanged">
            <ScrollViewer x:Name="DistributionsPanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <Border x:Name="DistributionsFrame" MaxWidth="2800" HorizontalAlignment="Center" Padding="40,32,40,40"><StackPanel Spacing="20">
                    <TextBlock Text="Distributions" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Inspect and manage registered WSL distributions." Style="{StaticResource BodyTextBlockStyle}" Opacity="0.78" />
                    <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Refresh" Click="Refresh_Click" /><Button Content="Add distribution…" Click="AddDistribution_Click" /><ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" VerticalAlignment="Center" /><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                    <Grid x:Name="DistributionColumns" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Registered distributions" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ListView x:Name="DistributionList" SelectionMode="Single" SelectionChanged="DistributionList_SelectionChanged" MinHeight="220" MaxHeight="680" AutomationProperties.Name="Registered WSL distributions">
                                    <ListView.ItemTemplate><DataTemplate><Grid Padding="8,10" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"><Image Width="42" Height="42" Source="{Binding LogoKey, Converter={StaticResource DistributionLogoConverter}}" Stretch="Uniform" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Opacity="0.8" /><TextBlock Text="{Binding Flags}" FontSize="12" Opacity="0.72" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyDistributions" Text="No distributions detected. Install or register a WSL distribution, then refresh." TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="DistributionDetailsPane" Grid.Row="0" Grid.Column="0" Spacing="14">
                            <Border x:Name="SelectedDistroCard" Padding="22" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                                <StackPanel Spacing="14"><TextBlock x:Name="SelectedDistroName" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="SelectedDistroDetails" TextWrapping="Wrap" />
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Start" Click="Start_Click" /><Button Content="Terminate" Click="Terminate_Click" /><Button Content="Set default" Click="SetDefault_Click" /></StackPanel>
                                        <StackPanel x:Name="ConvertPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><ComboBox x:Name="ConvertVersion" Header="Convert to" Width="180" AutomationProperties.Name="Target WSL version"><ComboBoxItem Content="WSL 1" Tag="1" /><ComboBoxItem Content="WSL 2" Tag="2" /></ComboBox><Button Content="Convert" Click="Convert_Click" VerticalAlignment="Bottom" /></StackPanel>
                                        <TextBlock x:Name="ConvertCapabilityStatus" Text="Checking conversion support…" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Padding="22" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10"><TextBlock Text="Distribution details" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DetailsHint" Text="Select a distribution to view its details and available actions." TextWrapping="Wrap" /><ItemsControl x:Name="DetailsTable"><ItemsControl.ItemTemplate><DataTemplate><Grid Padding="8,6" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Latest operation" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" /><TextBlock x:Name="OperationOutput" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel></Border>
            </ScrollViewer>
            <ScrollViewer x:Name="BackupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border x:Name="BackupFrame" MaxWidth="2800" HorizontalAlignment="Center" Padding="40,32,40,40"><StackPanel Spacing="20">
                    <TextBlock Text="Backup &amp; Restore" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Export existing distributions or restore a backup into a new name and location." TextWrapping="Wrap" Opacity="0.78" />
                    <Grid x:Name="BackupColumns" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Padding="22" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Create a backup" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="1. Choose distributions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Select multiple items with Ctrl+click or Ctrl+Space." TextWrapping="Wrap" Opacity="0.8" />
                                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Select all" Click="BackupSelectAll_Click" /><Button Content="Clear selection" Click="BackupClearSelection_Click" /><TextBlock x:Name="BackupSelectionSummary" Text="No distributions selected" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                                <ListView x:Name="BackupDistroList" SelectionMode="Multiple" SelectionChanged="BackupDistroList_SelectionChanged" MinHeight="150" MaxHeight="360" AutomationProperties.Name="Distributions to back up">
                                    <ListView.ItemTemplate><DataTemplate><StackPanel Padding="6,8" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.8" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="2. Choose format and destination" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="BackupFormat" Header="Backup format" SelectedIndex="0" Width="440"><ComboBoxItem Content="TAR (works with WSL 1 and WSL 2)" Tag="Tar" /><ComboBoxItem Content="VHDX (WSL 2 only)" Tag="Vhdx" /></ComboBox>
                                <TextBox x:Name="BackupDestination" Header="Existing destination folder" PlaceholderText="Choose where new backup files will be created" HorizontalAlignment="Stretch" /><Button Content="Browse for backup folder…" Click="BackupBrowse_Click" HorizontalAlignment="Left" />
                                <TextBlock Text="3. Review and create backup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Content="Create backup" Click="Backup_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="RestoreCard" Grid.Row="0" Grid.Column="0" Padding="22" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Restore from a backup" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Restores always register a new distribution. Existing registrations and installation folders are never overwritten. Imported distributions may start as root; set a default Linux user if needed." TextWrapping="Wrap" Opacity="0.8" />
                                <TextBox x:Name="RestoreSource" Header="Backup file" PlaceholderText="Select a .tar or supported .vhdx file" HorizontalAlignment="Stretch" /><Button Content="Browse for backup…" Click="RestoreBrowse_Click" HorizontalAlignment="Left" />
                                <TextBox x:Name="RestoreName" Header="New distribution name" PlaceholderText="For example Ubuntu-Restored" HorizontalAlignment="Stretch" TextChanged="RestoreName_TextChanged" />
                                <TextBox x:Name="RestoreDestination" Header="New installation folder" PlaceholderText="A new folder will be created under the selected parent" HorizontalAlignment="Stretch" /><Button Content="Choose parent folder…" Click="RestoreFolderBrowse_Click" HorizontalAlignment="Left" />
                                <Button Content="Restore to new distribution" Click="Restore_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Backup history" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" /><Button Content="Refresh" Click="BackupHistoryRefresh_Click" /></StackPanel>
                            <TextBox x:Name="BackupHistoryOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="120" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="12"><ProgressRing x:Name="BackupBusy" Width="22" Height="22" IsActive="False" /><TextBlock x:Name="BackupStatus" Text="Ready" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                    <Border Padding="18" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock x:Name="BackupOutput" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Border>
                </StackPanel></Border>
            </ScrollViewer>
            <ScrollViewer x:Name="MigrationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border x:Name="MigrationFrame" MaxWidth="2800" HorizontalAlignment="Center" Padding="40,32,40,40"><StackPanel Spacing="20">
                    <TextBlock Text="Move &amp; Clone" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Move uses native WSL support only. Clone creates a separate distribution and preserves its source." TextWrapping="Wrap" Opacity="0.78" />
                    <ComboBox x:Name="MigrationDistro" Header="Source distribution" HorizontalAlignment="Stretch" SelectionChanged="MigrationDistro_SelectionChanged" />
                    <Grid x:Name="MigrationColumns" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Padding="24" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16"><TextBlock Text="Move this distribution" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Moves the existing WSL 2 installation. The source location changes after verification." TextWrapping="Wrap" Opacity="0.8" /><TextBox x:Name="MoveDestination" Header="New installation folder" PlaceholderText="Choose a new, empty folder" HorizontalAlignment="Stretch" TextChanged="MoveDestination_TextChanged" /><Button Content="Browse for move folder…" Click="MoveBrowse_Click" HorizontalAlignment="Left" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview move" Click="MovePreview_Click" /><Button Content="Move distribution" Click="Move_Click" /></StackPanel></StackPanel>
                        </Border>
                        <Border x:Name="CloneCard" Grid.Row="0" Grid.Column="0" Padding="24" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="16"><TextBlock Text="Create a separate clone" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="The original stays registered. Choose a new distribution name and a separate installation folder." TextWrapping="Wrap" Opacity="0.8" /><TextBox x:Name="CloneName" Header="New clone name" PlaceholderText="For example Ubuntu-Test" HorizontalAlignment="Stretch" TextChanged="CloneName_TextChanged" /><TextBox x:Name="CloneDestination" Header="Clone installation folder" PlaceholderText="A new folder will be created under the selected parent" HorizontalAlignment="Stretch" /><Button Content="Choose parent folder…" Click="CloneBrowse_Click" HorizontalAlignment="Left" /><Button Content="Create clone" Click="Clone_Click" HorizontalAlignment="Left" /></StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12"><ProgressRing x:Name="MigrationBusy" Width="22" Height="22" IsActive="False" /><TextBlock x:Name="MigrationStatus" Text="Ready" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                    <Border Padding="18" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock x:Name="MigrationOutput" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Border>
                </StackPanel></Border>
            </ScrollViewer>
            <ScrollViewer x:Name="StoragePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border x:Name="StorageFrame" MaxWidth="2800" HorizontalAlignment="Center" Padding="40,32,40,40"><StackPanel Spacing="20">
                    <TextBlock Text="Storage" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Compare Linux filesystem use, virtual disk allocation/capacity, and free space on Windows volumes when WSL exposes them." TextWrapping="Wrap" Opacity="0.78" />
                    <Grid x:Name="StorageColumns" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Padding="24" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="16"><TextBlock Text="Inspect distribution storage" Style="{StaticResource SubtitleTextBlockStyle}" /><ComboBox x:Name="StorageDistro" Header="Distribution" HorizontalAlignment="Stretch" /><Button Content="Inspect storage" Click="StorageInspect_Click" HorizontalAlignment="Left" /></StackPanel></Border>
                        <Border x:Name="ResizeCard" Grid.Row="0" Grid.Column="0" Padding="24" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="16"><TextBlock Text="Expand virtual disk" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBox x:Name="ResizeTarget" Header="New capacity" PlaceholderText="For example 128GB" HorizontalAlignment="Stretch" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview expansion" Click="ResizePreview_Click" /><Button Content="Expand virtual disk…" Click="Resize_Click" /></StackPanel><TextBlock Text="Logical Linux filesystem use, allocated VHDX size, and virtual disk capacity are distinct measurements. Expansion does not shrink the VHDX or reduce Linux data." TextWrapping="Wrap" Opacity="0.8" /></StackPanel></Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12"><ProgressRing x:Name="StorageBusy" Width="22" Height="22" IsActive="False" /><TextBlock x:Name="StorageStatus" Text="Choose a distribution and inspect." TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                    <Border Padding="18" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBox x:Name="StorageOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="180" PlaceholderText="Storage results will appear here after inspection or preview." /></Border>
                </StackPanel></Border>
            </ScrollViewer>
            <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border x:Name="DiagnosticsFrame" MaxWidth="2800" HorizontalAlignment="Center" Padding="40,32,40,40"><StackPanel Spacing="20">
                    <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Read-only WSL, host, configuration, capability, and operation-history information." TextWrapping="Wrap" Opacity="0.78" />
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh diagnostics" Click="DiagnosticsRefresh_Click" /><Button Content="Export JSON…" Click="DiagnosticsExport_Click" /><Button Content="Refresh operation history" Click="HistoryRefresh_Click" /></StackPanel>
                    <Grid x:Name="DiagnosticsColumns" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><TextBlock Text="System report" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBox x:Name="DiagnosticsOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="420" /></StackPanel></Border>
                        <Border x:Name="HistoryCard" Grid.Row="0" Grid.Column="0" Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><TextBlock Text="Recent operations" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBox x:Name="HistoryOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="420" /></StackPanel></Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12"><ProgressRing x:Name="DiagnosticsBusy" Width="22" Height="22" IsActive="False" /><TextBlock x:Name="DiagnosticsStatus" Text="Diagnostics have not been refreshed yet." TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                </StackPanel></Border>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Border x:Name="SettingsFrame" MaxWidth="1400" HorizontalAlignment="Center" Padding="40,32,40,40"><StackPanel Spacing="20">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Preferences are stored for the current Windows user. They do not change global WSL or Windows configuration." TextWrapping="Wrap" Opacity="0.78" />
                    <ComboBox x:Name="ThemeChoice" Header="App theme" SelectedIndex="0" Width="260" SelectionChanged="ThemeChoice_SelectionChanged"><ComboBoxItem Content="System" Tag="System" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" /></ComboBox>
                    <TextBox x:Name="RetentionDays" Header="Log retention (days, 1–3650)" Text="90" Width="260" />
                    <TextBlock Text="Default folders" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Choose existing folders once. Diagnostics JSON exports use the export folder; WSL backups use the backup folder. New distro installs, imports, restores, and clones create a child folder under the installation root." TextWrapping="Wrap" Opacity="0.78" />
                    <TextBox x:Name="DefaultExportDirectory" Header="Default export folder" PlaceholderText="Optional existing folder" HorizontalAlignment="Stretch" /><Button Content="Choose export folder…" Click="ExportDirectoryBrowse_Click" HorizontalAlignment="Left" />
                    <TextBox x:Name="DefaultBackupDirectory" Header="Default backup folder" PlaceholderText="Optional existing folder" HorizontalAlignment="Stretch" /><Button Content="Choose backup folder…" Click="BackupDirectoryBrowse_Click" HorizontalAlignment="Left" />
                    <TextBox x:Name="DefaultInstallDirectory" Header="Default installation root" PlaceholderText="Optional existing folder" HorizontalAlignment="Stretch" /><Button Content="Choose installation root…" Click="InstallDirectoryBrowse_Click" HorizontalAlignment="Left" />
                    <Button Content="Save settings" Click="SettingsSave_Click" HorizontalAlignment="Left" /><TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel></Border>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
